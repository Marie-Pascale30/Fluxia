# Variables du déploiement Docker (docker-compose.prod.yml). Guide : docs/deploiement.md
# Liste complète des options de l'API : apps/api/.env.example ; du web : apps/web/.env.example

# ─── Indispensables ──────────────────────────────────────────────
# Nom de domaine pointant vers le serveur (enregistrement DNS A/AAAA) : HTTPS automatique
DOMAIN=app.mon-domaine.fr
# Secrets : openssl rand -base64 32 (mot de passe) / openssl rand -base64 48 (JWT)
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-with-a-long-random-string
APP_TIMEZONE=Europe/Paris

# ─── Emails (indispensable en production : mots de passe oubliés, factures…) ──
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.fournisseur.fr:465
# MAIL_FROM="Fluxia <notifications@mon-domaine.fr>"

# ─── Abonnements (Stripe) ────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_…
# STRIPE_PRICE_ID=price_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# TRIAL_DAYS=14

# ─── IA, SMS, transcription (facultatifs) ────────────────────────
# ANTHROPIC_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TRANSCRIPTION_URL=
# TRANSCRIPTION_API_KEY=

# ─── Pages légales (exploitant de la plateforme) ─────────────────
# LEGAL_OPERATOR_NAME=
# LEGAL_OPERATOR_STATUS=
# LEGAL_OPERATOR_REGISTRATION=
# LEGAL_CONTACT_EMAIL=
# LEGAL_PUBLICATION_DIRECTOR=
# LEGAL_UPDATED_AT=

# ─── Sauvegardes ─────────────────────────────────────────────────
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR=3
