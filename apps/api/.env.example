# ─── Base de données (docker compose : npm run db:up) ───────────
DATABASE_URL="postgresql://fluxia:fluxia@localhost:5434/fluxia?schema=public"
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Fuseau horaire métier (planning, horaires de travail)
APP_TIMEZONE=Europe/Paris

# ─── Sécurité ────────────────────────────────────────────────────
# Obligatoire en production (32 caractères minimum) : openssl rand -base64 48
JWT_SECRET=

# ─── IA ──────────────────────────────────────────────────────────
# Vide : moteur heuristique local. Renseignée : Claude (repli automatique sur le moteur local).
ANTHROPIC_API_KEY=

# ─── Géolocalisation des adresses ────────────────────────────────
# ign (défaut, service public gratuit) | none (hors ligne : centre de Paris)
GEOCODER=ign

# ─── Emails sortants ─────────────────────────────────────────────
# Vide : simulation (messages tracés, rien n'est envoyé).
# Exemple : smtps://utilisateur:motdepasse@ssl0.ovh.net:465
SMTP_URL=
MAIL_FROM="Fluxia <maintenance@votre-entreprise.fr>"
COMPANY_SIGNATURE="L'équipe maintenance"

# ─── SMS (Twilio) ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── Emails entrants ─────────────────────────────────────────────
# Webhook POST /api/inbound/email?token=… (Postmark, Mailgun, SendGrid…)
INBOUND_EMAIL_TOKEN=
# Relève IMAP (facultatif) : imaps://utilisateur:motdepasse@imap.exemple.fr:993
IMAP_URL=
IMAP_POLL_SECONDS=60

# ─── Entreprise (en-tête et mentions légales des PDF) ────────────
COMPANY_NAME="Fluxia Maintenance"
COMPANY_ADDRESS="12 rue Exemple, 75011 Paris"
COMPANY_PHONE=
COMPANY_EMAIL=
# Obligatoire sur les factures : forme juridique, capital, SIRET, RCS, TVA intracommunautaire
COMPANY_LEGAL="SAS au capital de 10 000 € · SIRET 000 000 000 00000 · TVA FR00000000000"
# Facturation
PAYMENT_TERMS_DAYS=30
ACCOUNT_REVENUE=706000
ACCOUNT_VAT=445710
# Lien public des emails (portail client)
PUBLIC_WEB_URL=http://localhost:3000
# Entretien préventif automatique (6 h chaque jour)
MAINTENANCE_AUTO=true
MAINTENANCE_HORIZON_DAYS=30
# Transcription audio serveur (API compatible OpenAI / Whisper), facultatif
TRANSCRIPTION_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
# Stockage des fichiers déposés
UPLOAD_DIR=storage
