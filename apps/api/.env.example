# ─── Base de données (docker compose : npm run db:up) ───────────
DATABASE_URL="postgresql://fluxia:fluxia@localhost:5434/fluxia?schema=public"
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Fuseau horaire métier (planning, horaires de travail)
APP_TIMEZONE=Europe/Paris

# ─── Sécurité ────────────────────────────────────────────────────
# Obligatoire en production (32 caractères minimum) : openssl rand -base64 48
JWT_SECRET=
# Inscriptions de nouvelles entreprises par minute et par adresse IP
SIGNUP_RATE_LIMIT=5

# ─── IA ──────────────────────────────────────────────────────────
# Vide : moteur heuristique local. Renseignée : Claude (repli automatique sur le moteur local).
ANTHROPIC_API_KEY=

# ─── Géolocalisation des adresses ────────────────────────────────
# ign (défaut, service public gratuit) | none (hors ligne : centre de Paris)
GEOCODER=ign

# ─── Emails sortants ─────────────────────────────────────────────
# Vide : simulation (messages tracés, rien n'est envoyé).
# Exemple : smtps://utilisateur:motdepasse@ssl0.ovh.net:465
SMTP_URL=
# Adresse d'envoi de la plateforme. Le nom affiché est celui de l'entreprise,
# et les réponses des clients vont à l'email renseigné dans ses paramètres.
MAIL_FROM="Fluxia <notifications@votre-domaine.fr>"

# ─── Abonnements (Stripe) ────────────────────────────────────────
# Vide : pas de paiement en ligne (les nouvelles entreprises restent en essai).
# Clé secrète (sk_live_… ou sk_test_…), prix de l'abonnement (price_…) créé dans le tableau de bord Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Secret du webhook (whsec_…) : point de terminaison https://votre-domaine/api/billing/webhook, événements
# checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=
# Durée de l'essai gratuit à l'inscription (jours)
TRIAL_DAYS=14

# ─── SMS (Twilio) ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── Emails entrants ─────────────────────────────────────────────
# Webhook POST /api/inbound/email?token=… (Postmark, Mailgun, SendGrid…) :
# chaque entreprise a son jeton, visible dans ses paramètres.
# Relève IMAP (facultatif) : imaps://utilisateur:motdepasse@imap.exemple.fr:993
IMAP_URL=
IMAP_POLL_SECONDS=60
# Entreprise destinataire de la boîte IMAP (facultatif s'il n'y a qu'une entreprise)
IMAP_ORGANIZATION_ID=

# Coordonnées, mentions légales, délai de paiement et comptes comptables :
# propres à chaque entreprise, dans Paramètres (plus de variables COMPANY_*).
# Lien public des emails (portail client)
PUBLIC_WEB_URL=http://localhost:3000
# Entretien préventif automatique (6 h chaque jour)
MAINTENANCE_AUTO=true
MAINTENANCE_HORIZON_DAYS=30
# Transcription audio serveur (API compatible OpenAI / Whisper), facultatif
TRANSCRIPTION_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
# Stockage des fichiers déposés
UPLOAD_DIR=storage
