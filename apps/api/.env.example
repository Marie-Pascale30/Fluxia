# ─── Base de données (docker compose : npm run db:up) ───────────
DATABASE_URL="postgresql://fluxia:fluxia@localhost:5434/fluxia?schema=public"
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Fuseau horaire métier (planning, horaires de travail)
APP_TIMEZONE=Europe/Paris

# ─── Sécurité ────────────────────────────────────────────────────
# Obligatoire en production (32 caractères minimum) : openssl rand -base64 48
JWT_SECRET=

# ─── IA ──────────────────────────────────────────────────────────
# Vide : moteur heuristique local. Renseignée : Claude (repli automatique sur le moteur local).
ANTHROPIC_API_KEY=

# ─── Géolocalisation des adresses ────────────────────────────────
# ign (défaut, service public gratuit) | none (hors ligne : centre de Paris)
GEOCODER=ign

# ─── Emails sortants ─────────────────────────────────────────────
# Vide : simulation (messages tracés, rien n'est envoyé).
# Exemple : smtps://utilisateur:motdepasse@ssl0.ovh.net:465
SMTP_URL=
MAIL_FROM="Fluxia <maintenance@votre-entreprise.fr>"
COMPANY_SIGNATURE="L'équipe maintenance"

# ─── SMS (Twilio) ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── Emails entrants ─────────────────────────────────────────────
# Webhook POST /api/inbound/email?token=… (Postmark, Mailgun, SendGrid…)
INBOUND_EMAIL_TOKEN=
# Relève IMAP (facultatif) : imaps://utilisateur:motdepasse@imap.exemple.fr:993
IMAP_URL=
IMAP_POLL_SECONDS=60
