// Modèle de données Fluxia (PostgreSQL).
// Montants en centimes (Int) ; dates en UTC, affichées dans APP_TIMEZONE.
// Évolution du schéma : `npm run db:migrate -- --name <changement>`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
  // Client TypeScript sans moteur natif : connexion via @prisma/adapter-pg
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Vocabulaire métier ──────────────────────────────────────────

enum EquipmentType {
  CLIMATISATION
  CHAUFFAGE
  VMC
  PLOMBERIE
  ELECTRICITE
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestChannel {
  EMAIL
  PHONE
  FORM
}

enum RequestStatus {
  NEW
  ANALYZED
  CONVERTED
  ANSWERED
  ARCHIVED
}

enum RequestCategory {
  BREAKDOWN
  QUOTE_REQUEST
  MAINTENANCE
  OTHER
}

enum SuggestedAction {
  CREATE_INTERVENTION
  PREPARE_QUOTE
  SCHEDULE_MAINTENANCE
  REPLY
}

enum InterventionType {
  BREAKDOWN
  MAINTENANCE
  INSTALLATION
  AFTER_SALES
}

enum InterventionStatus {
  TO_SCHEDULE
  SCHEDULED
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

enum ReportStatus {
  DRAFT
  VALIDATED
  SENT
}

enum QuoteStatus {
  DRAFT
  VALIDATED
  SENT
  ACCEPTED
  REFUSED
}

enum QuoteLineKind {
  PART
  LABOR
  TRAVEL
  OTHER
}

enum ActivityActor {
  AI
  USER
  TECHNICIAN
  SYSTEM
}

enum UserRole {
  MANAGER
  TECHNICIAN
}

enum MessageChannel {
  EMAIL
  SMS
  PUSH
}

enum AttachmentKind {
  PHOTO
  SIGNATURE
  AUDIO
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

// ─── Utilisateurs ────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(MANAGER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  /// Compte d'un technicien : accès limité à ses propres missions
  technicianId String?     @unique
  technician   Technician? @relation(fields: [technicianId], references: [id])
}

// ─── Référentiels ────────────────────────────────────────────────

model Client {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  contactName String?
  createdAt   DateTime @default(now())
  /// Version des liens du portail client : l'incrémenter révoque tous les liens existants
  portalVersion Int    @default(1)

  sites         Site[]
  contracts     Contract[]
  requests      InboundRequest[]
  interventions Intervention[]
  quotes        Quote[]
}

model Site {
  id         String @id @default(cuid())
  clientId   String
  label      String
  address    String
  postalCode String
  city       String
  lat        Float
  lng        Float

  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  equipments    Equipment[]
  interventions Intervention[]
  requests      InboundRequest[]
}

model Equipment {
  id          String        @id @default(cuid())
  siteId      String
  type        EquipmentType
  label       String
  brand       String?
  model       String?
  installedAt DateTime?

  site          Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  interventions Intervention[]
  requests      InboundRequest[]
}

model Contract {
  id              String    @id @default(cuid())
  clientId        String
  reference       String    @unique
  label           String
  startDate       DateTime
  endDate         DateTime
  coversLabor     Boolean   @default(true)
  coversParts     Boolean   @default(false)
  coversTravel    Boolean   @default(true)
  nextServiceDate DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Technician {
  id        String          @id @default(cuid())
  firstName String
  lastName  String
  email     String          @unique
  phone     String?
  skills    EquipmentType[]
  baseLat   Float
  baseLng   Float
  active    Boolean         @default(true)

  interventions Intervention[]
  user          User?
}

model CatalogItem {
  id             String        @id @default(cuid())
  code           String        @unique
  kind           QuoteLineKind
  label          String
  unitPriceCents Int
  /// Mots-clés détectés dans les notes des techniciens
  keywords       String[]
}

// ─── Flux métier ─────────────────────────────────────────────────

model InboundRequest {
  id          String         @id @default(cuid())
  channel     RequestChannel @default(EMAIL)
  fromName    String
  fromEmail   String
  subject     String
  body        String
  receivedAt  DateTime       @default(now())
  /// Identifiant du message d'origine (Message-ID) : évite les doublons
  externalId  String?        @unique
  status      RequestStatus  @default(NEW)
  attachments Int            @default(0)

  // Résultat d'analyse IA
  category        RequestCategory?
  priority        Priority?
  summary         String?
  symptoms        String[]
  suggestedAction SuggestedAction?
  confidence      Float?
  aiProvider      String?
  analyzedAt      DateTime?
  /// Coordonnées repérées dans le message (pour créer la fiche client)
  extractedPhone   String?
  extractedAddress String?

  clientId    String?
  siteId      String?
  equipmentId String?

  client       Client?       @relation(fields: [clientId], references: [id])
  site         Site?         @relation(fields: [siteId], references: [id])
  equipment    Equipment?    @relation(fields: [equipmentId], references: [id])
  intervention Intervention?
  quote        Quote?

  @@index([status, receivedAt])
}

model Intervention {
  id               String             @id @default(cuid())
  number           Int                @unique
  type             InterventionType   @default(BREAKDOWN)
  priority         Priority           @default(NORMAL)
  status           InterventionStatus @default(TO_SCHEDULE)
  title            String
  description      String
  initialDiagnosis String?
  estimatedMinutes Int                @default(90)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  dispatchedAt     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  closedAt         DateTime?
  cancelledReason  String?
  /// Signature du client en fin d'intervention
  signedBy         String?
  signedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  clientId     String
  siteId       String
  equipmentId  String?
  technicianId String?
  requestId    String? @unique

  client     Client          @relation(fields: [clientId], references: [id])
  site       Site            @relation(fields: [siteId], references: [id])
  equipment  Equipment?      @relation(fields: [equipmentId], references: [id])
  technician Technician?     @relation(fields: [technicianId], references: [id])
  request    InboundRequest? @relation(fields: [requestId], references: [id])
  report      Report?
  quotes      Quote[]
  attachments Attachment[]

  @@index([technicianId, scheduledStart])
  @@index([status])
}

model Report {
  id             String       @id @default(cuid())
  interventionId String       @unique
  status         ReportStatus @default(DRAFT)
  voiceNote      String
  reason         String
  diagnosis      String
  workDone       String
  result         String
  recommendation String?
  /// ReportPart[] : { label, catalogCode, quantity }
  parts          Json         @default("[]")
  laborHours     Float        @default(1)
  billable       Boolean      @default(false)
  billingNotes   String?
  aiProvider     String
  createdAt      DateTime     @default(now())
  validatedAt    DateTime?
  sentAt         DateTime?

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  quote        Quote?
}

model Quote {
  id          String      @id @default(cuid())
  number      String      @unique
  status      QuoteStatus @default(DRAFT)
  title       String
  notes       String?
  /// Points que le responsable doit contrôler avant validation
  warnings    String[]
  vatRate     Float       @default(0.2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  validatedAt DateTime?
  sentAt      DateTime?
  decidedAt   DateTime?
  /// Décision du client (portail) : nom du signataire et motif éventuel de refus
  decisionBy   String?
  decisionNote String?

  clientId       String
  interventionId String?
  reportId       String? @unique
  requestId      String? @unique

  client       Client          @relation(fields: [clientId], references: [id])
  intervention Intervention?   @relation(fields: [interventionId], references: [id])
  report       Report?         @relation(fields: [reportId], references: [id])
  request      InboundRequest? @relation(fields: [requestId], references: [id])
  lines        QuoteLine[]
}

model QuoteLine {
  id             String        @id @default(cuid())
  quoteId        String
  position       Int
  kind           QuoteLineKind
  label          String
  quantity       Float
  unitPriceCents Int
  catalogCode    String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

/// Fichiers liés à une intervention (photos, signature, enregistrement audio).
/// Le contenu est stocké hors base (StorageService) sous `storageKey`.
model Attachment {
  id             String         @id @default(cuid())
  interventionId String
  kind           AttachmentKind
  filename       String
  mimeType       String
  size           Int
  storageKey     String         @unique
  caption        String?
  uploadedBy     String?
  createdAt      DateTime       @default(now())

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([interventionId])
}

// ─── Traçabilité ─────────────────────────────────────────────────

/// Journal d'audit : chaque action de l'IA ou d'un humain est tracée.
model Activity {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now())
  actor      ActivityActor
  /// Nom de l'utilisateur à l'origine de l'action (si humaine)
  actorName  String?
  type       String
  message    String
  entityType String
  entityId   String

  @@index([entityId])
  @@index([createdAt])
}

/// Messages sortants (emails clients, missions techniciens, SMS).
/// Boîte d'envoi : créés en PENDING dans la transaction métier, puis expédiés
/// en arrière-plan avec nouvelles tentatives (OutboxService).
model OutboundMessage {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  channel     MessageChannel @default(EMAIL)
  recipient   String
  subject     String
  body        String
  entityType  String
  entityId    String
  /// Pièces jointes générées à l'envoi : [{ kind: "REPORT_PDF" | "QUOTE_PDF", id }]
  attachments Json           @default("[]")

  status      MessageStatus  @default(PENDING)
  attempts    Int            @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError   String?
  /// Transport utilisé : smtp, twilio, log (simulation)…
  transport   String?
  providerId  String?
  sentAt      DateTime?

  @@index([entityId])
  @@index([status, nextAttemptAt])
}

/// Compteurs de numérotation (interventions, devis…) incrémentés atomiquement.
model Counter {
  key   String @id
  value Int
}
